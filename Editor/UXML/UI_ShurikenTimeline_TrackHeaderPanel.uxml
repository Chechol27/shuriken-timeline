<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="pnl_track_headers" style="flex-grow: 1; max-width: none; margin-right: 1px; min-width: auto;">
        <ui:VisualElement name="pnl_track_head_controls" style="flex-grow: 0; min-height: 20px; max-height: 20px; background-color: rgb(43, 43, 43);">
            <ui:Button text="&#10;" style="max-width: 25px; flex-direction: row; justify-content: space-between; align-content: center; padding-left: 2px; padding-right: 2px; min-height: 18px; max-height: 18px; margin-top: 0; margin-bottom: 0; border-bottom-width: 0; border-top-width: 0; border-left-width: 0; border-right-width: 0;">
                <ui:Label text="+" name="Label" style="margin-left: 2px; margin-right: 0; -unity-font-style: bold; padding-top: 0; padding-bottom: 0; margin-bottom: 0; -unity-text-align: middle-center; translate: 0 -1px; margin-top: 0;"/>
                <ui:Label text="▼" style="margin-left: 0; margin-right: 0; font-size: 5px; -unity-text-align: middle-center; -unity-font-style: bold; padding-top: 0; padding-bottom: 0; translate: -3px 0; margin-top: 0; margin-bottom: 0;"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="pnl_header_container" style="flex-grow: 1;"/>
        <ui:VisualElement name="pnl_resize_bar_spacer" style="flex-grow: 0; min-height: 20px; max-height: 20px; background-color: rgb(43, 43, 43);"/>
    </ui:VisualElement>
</ui:UXML>
